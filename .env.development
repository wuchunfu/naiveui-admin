# 是否开启代理
VITE_HTTP_PROXY=Y
# 代理前缀
VITE_PROXY_PREFIX=/dev-api
# 代理服务器地址
VITE_PROXY_SERVER_URL=http://localhost:8001/api
# 基础 URL: 设置 nginx 代理就写代理地址，比如: /prod-api, 否则写完整 URL, 比如: http://localhost:8080/api
VITE_BASE_URL=/dev-api
# 资源基础路径, 比如: /admin, 需要以 / 开头和结尾, 如何使用了 nginx, 则需要设置为, try_files $uri $uri/ /admin/index.html;
VITE_BASE_PATH=/
